# Copy this file to .env.local and fill in real values. .env.local is gitignored.
# See Docs/execution_plan.md §13 (Local Development Setup) for the full explanation of each variable.

# Local Postgres connection string. Matches docker-compose.yml's `db` service by default
# (run `docker compose up -d db` first). Required.
DATABASE_URL="postgresql://newinvoice:newinvoice@localhost:5432/newinvoice?schema=public"

# Base URL the PDF adapter (Docs/implementation_decisions.md §12.2) navigates to when
# rendering /invoices/[id]/print. Required. Port 3001 is used because 3000 may already be
# in use by other local services.
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Which Puppeteer browser-launch adapter to use. "local" (plain puppeteer) is what MVP build
# milestones M0-M12 target; "serverless" (puppeteer-core + @sparticuz/chromium) is only
# exercised at the follow-on M13 deployment-readiness milestone. Required for local dev.
PDF_ADAPTER="local"

# AI-assist configuration (Docs/implementation_decisions.md §19/§22) — ALL OPTIONAL.
# The AI-assist chat panel appears on every Party, Payment Method, and Invoice form (both
# creation AND editing an existing record), never on Project. It's pure progressive
# enhancement: with none of these set, the panel shows a quiet "not configured" state and
# every form remains 100% usable by hand. There is no in-app config UI for these — the
# "Configure" entry point is a read-only summary of whatever is set here.
#
# AI_PRIMARY_PROVIDER: one of "google" | "anthropic" | "groq"
# AI_PRIMARY_MODEL: the primary model id for the chosen provider, e.g. "gemini-2.5-flash"
#   (google), "claude-haiku-4-5" (anthropic), "llama-3.3-70b-versatile" (groq)
# AI_FALLBACK_SEQUENCE: comma-separated "provider:model" pairs tried in order if the primary
#   fails, e.g. "anthropic:claude-haiku-4-5,groq:llama-3.3-70b-versatile"
AI_PRIMARY_PROVIDER=""
AI_PRIMARY_MODEL=""
AI_FALLBACK_SEQUENCE=""
GOOGLE_API_KEY=""
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
