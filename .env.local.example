# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Local Postgres connection string. Matches docker-compose.yml's `db` service by default
# (run `docker compose up -d db` first). Required.
DATABASE_URL="postgresql://newinvoice:newinvoice@localhost:5432/newinvoice?schema=public"

# Base URL the PDF adapter (Docs/implementation_decisions.md §12.2) navigates to when
# rendering /invoices/[id]/print. Required. Port 3001 is the app's default dev port
# (see package.json's dev script) — change both together if you need a different port.
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Which Puppeteer browser-launch adapter to use. "local" (plain puppeteer) is the
# development default; "serverless" (puppeteer-core + @sparticuz/chromium) exists for an
# eventual serverless deployment target and is not exercised in local development.
PDF_ADAPTER="local"

# AI-assist chat panel (Docs/implementation_decisions.md §19) appears on every Party,
# Payment Method, and Invoice form (both creation AND editing an existing record), never
# on Project. It's pure progressive enhancement: with no provider configured, the panel
# shows a quiet "not configured" state and every form remains 100% usable by hand.
#
# Provider/model/API-key configuration is DB-backed — configure it at the in-app
# /settings page, not via env vars. SETTINGS_ENCRYPTION_KEY is the one AI-related env
# var: the local secret used to encrypt/decrypt saved API keys at rest (any string works,
# it's SHA-256-hashed to a key internally — just don't change it after keys are saved, or
# they become undecryptable). Required for /settings to function; the rest of the app
# works fine without it.
SETTINGS_ENCRYPTION_KEY=""
